# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Local SQLite (Default for instant zero-dependency execution):
DATABASE_URL="file:./dev.db"
# For PostgreSQL (e.g. Supabase, Neon, AWS RDS, Docker):
# DATABASE_URL="postgresql://user:password@localhost:5432/custodian_db?schema=public"

# Authentication / Security
JWT_SECRET="super-sacred-custodian-sanctuary-secret-key-2026"
JWT_EXPIRES_IN="7d"

# CORS Configuration (Next.js frontend URL)
FRONTEND_URL="http://localhost:3000"

# AI Provider Configuration (Google Gemini / OpenAI)
# Optional: If not provided, backend uses built-in authentic cultural synthesis fallback
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Upload Directory
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5
